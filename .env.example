# Copy this file to .env and fill in your Binance Demo Trading API key.
# Create keys at https://demo.binance.com/en/my/settings/api-management
# Never put live (production) keys here.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance USD-M Futures Demo REST API. Do not change unless Binance moves it.
BINANCE_BASE_URL=https://demo-fapi.binance.com

# How long (ms) Binance accepts a signed request after its timestamp.
BINANCE_RECV_WINDOW_MS=5000

# HTTP timeout (seconds) for each call to Binance.
BINANCE_TIMEOUT_SECONDS=10

# Database shared by the API and the worker. Create or upgrade it first with:
#     .venv\Scripts\alembic upgrade head
DATABASE_URL=sqlite:///binance_connector.db

# Price that triggers take-profit / stop-loss: MARK_PRICE (default) or CONTRACT_PRICE.
BINANCE_TRIGGER_PRICE_TYPE=MARK_PRICE

# User-data stream base URL used by the worker (the listenKey is appended).
BINANCE_STREAM_URL=wss://demo-fstream.binance.com/ws

# How often (seconds) the worker reconciles every active trade with Binance.
RECONCILE_INTERVAL_SECONDS=60

# Used only by the E2E tests: a symbol and a quantity large enough to reach
# the symbol's minimum order value (about 100 USDT on BTCUSDT).
E2E_SYMBOL=BTCUSDT
E2E_QUANTITY=0.002
