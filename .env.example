# Copy this file to .env and fill it in. Never put live (production) keys anywhere here.

# --- required ---------------------------------------------------------------------------

# Key that encrypts every account's Binance credentials in the database. Generate one with:
#     .venv\Scripts\python -m binance_connector.security.credentials
# Losing it makes stored credentials unreadable (Django resends them with the next request).
CREDENTIALS_ENCRYPTION_KEY=

# --- database ---------------------------------------------------------------------------

# Shared by the API and the worker. Create or upgrade it first with:
#     .venv\Scripts\alembic upgrade head
DATABASE_URL=sqlite:///binance_connector.db

# --- Binance (Demo) ---------------------------------------------------------------------

BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_STREAM_URL=wss://demo-fstream.binance.com/ws
# Combined market stream used by the worker's price feed (?streams=... is appended).
BINANCE_MARKET_STREAM_URL=wss://demo-fstream.binance.com/stream

# How long (ms) Binance accepts a signed request after its timestamp, and the HTTP timeout
# (seconds) per call. On a slow connection use 20000 and 30.
BINANCE_RECV_WINDOW_MS=5000
BINANCE_TIMEOUT_SECONDS=10

# Price that triggers take-profit / stop-loss: MARK_PRICE (default) or CONTRACT_PRICE.
BINANCE_TRIGGER_PRICE_TYPE=MARK_PRICE

# --- execution --------------------------------------------------------------------------

# How long (seconds) a LIMIT entry may wait for a fill before it is cancelled.
LIMIT_ENTRY_TIMEOUT_SECONDS=300

# Reject a MARKET request whose entry_price is further than this % from the mark price.
# Leave empty to switch the price guard off.
PRICE_GUARD_MAX_DEVIATION_PERCENT=

# Requests for different accounts run in parallel on this many threads.
EXECUTION_WORKERS=4

# How often (seconds) the worker reconciles every active position with Binance.
RECONCILE_INTERVAL_SECONDS=60

# --- our API ----------------------------------------------------------------------------

# If set, every API call must send "Authorization: Bearer <token>". Empty = no auth.
INBOUND_API_TOKEN=

# --- E2E tests only (not used by the service) --------------------------------------------

# A Binance Demo account the E2E tests trade on. Create keys at
# https://demo.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=
E2E_SYMBOL=BTCUSDT
E2E_QUANTITY=0.002
